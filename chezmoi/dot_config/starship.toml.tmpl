[terraform]
disabled = false

# Keep the prompt identical on every machine and over SSH: the username
# module (starship shows it with a 🔒 icon on SSH connections) and the
# hostname (previously enabled on Linux) both made the container machine
# prompt differ from the host prompt.
[hostname]
disabled = true

[username]
disabled = true

